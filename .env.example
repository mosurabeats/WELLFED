# Copy to .env.local and fill in what you need. Everything is optional.

# AI assistant, flyer reading and recipe drafting. Set one or both.
# Without a key the assistant uses the built-in offline parser and flyer
# text is parsed offline; flyer photos/PDFs need a key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Strongly recommended on any internet-reachable deployment: every API call
# must then send this code (enter it in Household → Data & privacy).
APP_ACCESS_CODE=

# Optional alternative Overpass (OpenStreetMap) endpoint for store search.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
